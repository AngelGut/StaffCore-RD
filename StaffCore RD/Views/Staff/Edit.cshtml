@model Staff
@using StaffCoreRD.Models
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>✏️ Editar Empleado</h1>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post" class="card p-4 shadow">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" required />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cedula" class="form-label">Cédula</label>
                <input asp-for="Cedula" class="form-control" required />
                <span asp-validation-for="Cedula" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cargo" class="form-label">Cargo</label>
                <input asp-for="Cargo" class="form-control" required />
                <span asp-validation-for="Cargo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Departamento" class="form-label">Departamento</label>
                <select asp-for="Departamento" class="form-select" required>
                    <option value="">Seleccionar...</option>
                    <option value="Tecnología">Tecnología</option>
                    <option value="Recursos Humanos">Recursos Humanos</option>
                    <option value="Finanzas">Finanzas</option>
                    <option value="Operaciones">Operaciones</option>
                </select>
                <span asp-validation-for="Departamento" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Salario" class="form-label">Salario (RD$)</label>
                <input asp-for="Salario" type="number" class="form-control" min="0" step="100" required />
                <span asp-validation-for="Salario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label">Fecha Ingreso</label>
                <input asp-for="FechaIngreso" type="date" class="form-control" required />
                <span asp-validation-for="FechaIngreso" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Activo" class="form-check-label">
                    <input asp-for="Activo" type="checkbox" class="form-check-input" />
                    Empleado Activo
                </label>
            </div>

            <button type="submit" class="btn btn-warning">💾 Guardar Cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}