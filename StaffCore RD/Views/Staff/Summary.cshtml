@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Resumen Estadístico";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>📊 Resumen Estadístico por Departamento</h1>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            ← Volver al Personal
        </a>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Departamento</th>
                    <th class="text-center">Total Empleados</th>
                    <th class="text-end">Total Nómina (RD$)</th>
                    <th class="text-end">Salario Promedio (RD$)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="badge bg-info">@item.Departamento</span></td>
                        <td class="text-center">@item.TotalEmpleados</td>
                        <td class="text-end">@string.Format("{0:N2}", item.TotalNomina)</td>
                        <td class="text-end">@string.Format("{0:N2}", item.SalarioPromedio)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td>TOTAL GENERAL:</td>
                    <td class="text-center">@ViewData["TotalEmpleados"]</td>
                    <td class="text-end">@string.Format("{0:N2}", ViewData["TotalNomina"])</td>
                    <td class="text-end">@string.Format("{0:N2}", ViewData["SalarioPromedio"])</td>
                </tr>
            </tfoot>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">ℹ️ Sin Datos</h4>
        <p>No hay datos disponibles para mostrar el resumen estadístico.</p>
    </div>
}