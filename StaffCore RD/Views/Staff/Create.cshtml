@model Staff
@using StaffCoreRD.Models
@{
    ViewData["Title"] = "Agregar Empleado";
}

<div class="row">
    <div class="col-md-8">
        <h1>➕ Nuevo Empleado</h1>

        <form asp-action="Create" method="post" class="mt-4" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre Completo *</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cedula" class="form-label">Cédula *</label>
                <input asp-for="Cedula" class="form-control" placeholder="Formato: 001-0000000-0" />
                <span asp-validation-for="Cedula" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cargo" class="form-label">Cargo *</label>
                <input asp-for="Cargo" class="form-control" placeholder="Ej: Analista de Sistemas" />
                <span asp-validation-for="Cargo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Departamento" class="form-label">Departamento *</label>
                <select asp-for="Departamento" class="form-select">
                    <option value="">-- Selecciona un departamento --</option>
                    <option value="Tecnología">Tecnología</option>
                    <option value="Recursos Humanos">Recursos Humanos</option>
                    <option value="Finanzas">Finanzas</option>
                    <option value="Operaciones">Operaciones</option>
                </select>
                <span asp-validation-for="Departamento" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Salario" class="form-label">Salario (RD$) *</label>
                <input asp-for="Salario" type="number" step="0.01" class="form-control" placeholder="Mínimo 23,223" />
                <span asp-validation-for="Salario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label">Fecha de Ingreso</label>
                <input asp-for="FechaIngreso" type="date" class="form-control" />
                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Activo" type="checkbox" class="form-check-input" checked />
                <label asp-for="Activo" class="form-check-label">Empleado Activo</label>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">💾 Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">❌ Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}